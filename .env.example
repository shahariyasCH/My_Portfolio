# Database connection string (PostgreSQL for Vercel/Neon, or SQLite file:./dev.db for local dev)
DATABASE_URL="postgres://user:password@host/database?sslmode=require"

# NextAuth Configuration
NEXTAUTH_SECRET="your-32-character-secret-key-here"
NEXTAUTH_URL="https://your-portfolio-domain.vercel.app"

# Admin Account & Recipient Email for Contact Form submissions
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="YourSecureAdminPassword123!"

# OPTION 1: Resend API Key for sending contact submissions directly to your email
RESEND_API_KEY="re_123456789"

# OPTION 2: Gmail SMTP (Alternative free email delivery using Gmail App Password)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-16-character-gmail-app-password"

# AI Chatbot Configuration (Optional - provides live LLM generation for Shahariyas Assistant)
# The chatbot is strictly trained & grounded on your portfolio data only (no off-topic hallucinations).
# Works seamlessly with Google Gemini API (free tier available at https://aistudio.google.com) or OpenAI.
GEMINI_API_KEY=""
# OPENAI_API_KEY=""

# Optional: Vercel Blob Token for persistent cloud uploads (PDFs, images)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token_here"
